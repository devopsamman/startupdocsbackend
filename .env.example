# Node Environment
NODE_ENV=production
PORT=5000

# MongoDB Database Connection String
DB_URL=mongodb+srv://username:password@cluster.mongodb.net/startupdocs?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_super_secret_high_entropy_key_min_64_characters
JWT_EXPIRE=7d

# Domain & CORS Settings (comma-separated for additional origins)
FRONTEND_URL=https://startupdocs.in
BACKEND_URL=https://startupdocsbackend.onrender.com
ALLOWED_ORIGINS=https://startupdocs.in,https://www.startupdocs.in,http://localhost:3000,http://localhost:5173

# Email SMTP Settings (Hostinger / Custom SMTP)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@startupdocs.io
SMTP_PASS=your_smtp_password
SMTP_FROM=StartupDocs <info@startupdocs.io>

# PhonePe Payment Gateway Credentials
PHONEPE_MERCHANT_ID=M22WKFI8JR5F2
PHONEPE_SALT_KEY=fec485a7-0ef4-47d8-ad85-f1925c931c38
PHONEPE_SALT_INDEX=1
PHONEPE_HOST_URL=https://api.phonepe.com/apis/hermes/pg/v1/pay
PHONEPE_STATUS_URL=https://api.phonepe.com/apis/hermes

# PayU Credentials (if applicable)
PAYU_KEY=your_payu_key
PAYU_SALT=your_payu_salt
